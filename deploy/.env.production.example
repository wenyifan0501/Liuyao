# Copy to deploy/.env.prod and replace every placeholder. Never commit the real file.
# Domain that serves both the site and /api. Must resolve to this host and have
# ports 80/443 reachable so Caddy can issue the certificate.
SITE_ADDRESS=liuyao.example.com

# Use one long random password in both places. URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://liuyao:replace-with-a-long-random-password@postgres:5432/liuyao

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_STREAM=true

# Keep quota enforcement ON in production: it is the only guard on model spend.
WEB_AI_ENABLED=true
WEB_QUOTA_ENFORCED=true
# Calls per user per UTC day (framing + initial + follow-ups + failures).
WEB_AI_USER_DAILY_CALLS=5
# Global daily token reservation. 600k ≈ 5 worst-case calls; raise only on purpose.
WEB_AI_DAILY_TOKEN_BUDGET=600000

# Comma-separated CIDRs allowed to set X-Forwarded-For. Default covers Docker's
# private ranges; do not widen it to the public internet.
TRUST_PROXY=172.16.0.0/12
