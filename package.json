{
  "name": "liuyao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "chat": "tsx src/cli.ts",
    "logs:summary": "tsx src/analyze-log.ts",
    "experiment:raw": "tsx src/experiments/rawSkillExperiment.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "tsx watch apps/server/main.ts",
    "server:start": "tsx apps/server/main.ts",
    "db:migrate": "tsx apps/server/admin.ts migrate",
    "invite:create": "tsx apps/server/admin.ts invite",
    "invite:revoke": "tsx apps/server/admin.ts revoke",
    "server:build": "tsc -p apps/server/tsconfig.build.json",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "web:local": "tsx apps/server/local.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.0",
    "@react-three/fiber": "^9.7.0",
    "@react-three/rapier": "^2.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "lucide-react": "^1.41.0",
    "lunar-typescript": "^1.8.6",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "three": "^0.185.1"
  }
}
