      "節氣直交三伏始",
      "喜逢滂沛足田園"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/93"
  },
  {
    "number": 94,
