[
  {
    "number": 1,
    "title": "第一籤　甲甲　大吉",
    "poem": [
      "巍巍獨步向雲間",
      "玉殿千官第一班",
      "富貴榮華天付汝",
      "福如東海壽如山"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/1"
  },
  {
    "number": 2,
    "title": "第二籤　甲乙　上吉",
    "poem": [
      "盈虛消息總天時",
      "自此君當百事宜",
      "若問前程歸縮地",
      "更須方寸好修為"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/2"
  },
  {
    "number": 3,
    "title": "第三籤　甲丙　中吉",
    "poem": [
      "衣食自然生處有",
      "勸君不用苦勞心",
      "但能孝悌存忠信",
      "福祿來成禍不侵"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/3"
  },
  {
    "number": 4,
    "title": "第四籤　甲丁　下吉",
    "poem": [
      "去年百事頗相宜",
      "若較今年時運衰",
      "好把瓣香告神佛",
      "莫教福謝悔無追"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/4"
  },
  {
    "number": 5,
    "title": "第五籤　甲戊　中平",
    "poem": [
      "子有三般不自由",
      "門庭蕭索冷如秋",
      "若逢牛鼠交承日",
      "萬事回春不用憂"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/5"
  },
  {
    "number": 6,
    "title": "第六籤　甲己　下平",
    "poem": [
      "何勞鼓瑟更吹笙",
      "寸步如登萬里程",
      "彼此懷疑不相信",
      "休將私意憶濃情"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/6"
  },
  {
    "number": 7,
    "title": "第七籤　甲庚　大吉",
    "poem": [
      "仙風道骨本天生",
      "又遇仙宗為主盟",
      "指日丹成謝巖谷",
      "一朝引領向天行"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/7"
  },
  {
    "number": 8,
    "title": "第八籤　甲辛　上上",
    "poem": [
      "年來耕稼苦無收",
      "今歲田疇定有秋",
      "況遇太平無事日",
      "士農工賈百無憂"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/8"
  },
  {
    "number": 9,
    "title": "第九籤　甲壬　大吉",
    "poem": [
      "望渠消息向長安",
      "常把菱花仔細看",
      "見說文書將入境",
      "今朝喜色上眉端"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/9"
  },
  {
    "number": 10,
    "title": "第十籤　甲癸　下吉",
    "poem": [
      "病患時時命蹇衰",
      "何須打瓦共鑽龜",
      "宜教重見一陽復",
      "始可求神仗佛持"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/10"
  },
  {
    "number": 11,
    "title": "第11簽 下下",
    "poem": [
      "今年好事一番新",
      "富貴榮華萃汝身",
      "誰道機關難料處",
      "到頭獨立轉傷神"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/11"
  },
  {
    "number": 12,
    "title": "第12簽 中平",
    "poem": [
      "營為期望在春前",
      "誰料秋來又不然",
      "直遇清江貴公子",
      "一生活計始安全"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/12"
  },
  {
    "number": 13,
    "title": "第13簽 中平",
    "poem": [
      "君今庚甲未亨通",
      "且向江頭作釣翁",
      "玉兔重生應發跡",
      "萬人頭上逞英雄"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/13"
  },
  {
    "number": 14,
    "title": "第14簽 下下",
    "poem": [
      "一見佳人便喜歡",
      "誰知去後有多般",
      "人情冷暖君休訝",
      "歷涉應知行路難"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/14"
  },
  {
    "number": 15,
    "title": "第15簽 中平",
    "poem": [
      "兩家門戶各相當",
      "不是姻緣莫較量",
      "直待春風好消息",
      "卻調琴瑟向蘭房"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/15"
  },
  {
    "number": 16,
    "title": "第16簽 下下",
    "poem": [
      "官事悠悠難辨明",
      "不如息了且歸耕",
      "傍人煽惑君休信",
      "此事當謀親弟兄"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/16"
  },
  {
    "number": 17,
    "title": "第17簽 下下",
    "poem": [
      "田園價貫好商量",
      "事到公庭彼此傷",
      "縱使機關圖得勝",
      "定為後世子孫殃"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/17"
  },
  {
    "number": 18,
    "title": "第18簽 中平",
    "poem": [
      "知君指擬是空華",
      "底事茫茫未有涯",
      "牢把腳根踏實地",
      "善為善應永無差"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/18"
  },
  {
    "number": 19,
    "title": "第19簽 上吉",
    "poem": [
      "嗟子從來未得時",
      "今年星運頗相宜",
      "營求動作都如意",
      "和合婚姻誕貴兒"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/19"
  },
  {
    "number": 20,
    "title": "第20簽 下下",
    "poem": [
      "一生心事向誰論",
      "十八灘頭說與君",
      "世事盡從流水去",
      "功名富貴等浮雲"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/20"
  },
  {
    "number": 21,
    "title": "第21簽 下下",
    "poem": [
      "與君夙昔結成冤",
      "今日相逢那得緣",
      "好把經文多諷誦",
      "祈求戶內保嬋娟"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/21"
  },
  {
    "number": 22,
    "title": "第22簽 上吉",
    "poem": [
      "碧玉池中開白蓮",
      "莊嚴色相自天然",
      "生來骨格超凡俗",
      "正是人間第一仙"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/22"
  },
  {
    "number": 23,
    "title": "第23簽 下下",
    "poem": [
      "花開花謝在春風",
      "貴賤窮通百歲中",
      "羨子榮華今已矣",
      "到頭萬事總成空"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/23"
  },
  {
    "number": 24,
    "title": "第24簽 中平",
    "poem": [
      "一春萬事苦憂煎",
      "夏裏營求始帖然",
      "更遇秋成冬至後",
      "恰如騎鶴與腰纏"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/24"
  },
  {
    "number": 25,
    "title": "第25簽 中平",
    "poem": [
      "寅午戍年多阻滯",
      "亥子丑月漸亨嘉",
      "更逢玉兔金雞會",
      "枯木逢春自放花"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/25"
  },
  {
    "number": 26,
    "title": "第26簽 中吉",
    "poem": [
      "年來豐歉皆天數",
      "自是今年旱較多",
      "與子定期三日內",
      "田疇霑足雨滂沱"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/26"
  },
  {
    "number": 27,
    "title": "第27簽 下下",
    "poem": [
      "世間萬物各有主",
      "一粒一毫君莫取",
      "英雄豪傑自天生",
      "也須步步循規矩"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/27"
  },
  {
    "number": 28,
    "title": "第28簽 上吉",
    "poem": [
      "公侯將相本無種",
      "好把勤勞契上天",
      "人事盡從天理見",
      "才高豈得困林泉"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/28"
  },
  {
    "number": 29,
    "title": "第29簽 上上",
    "poem": [
      "祖宗積德幾多年",
      "源遠流長慶自然",
      "若更操修無倦已",
      "天須還汝舊青氈"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/29"
  },
  {
    "number": 30,
    "title": "第30簽 中吉",
    "poem": [
      "奉公謹守莫欺心",
      "自有亨通吉利臨",
      "目下營求且休矣",
      "秋期與子定佳音"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/30"
  },
  {
    "number": 31,
    "title": "第31簽 中吉",
    "poem": [
      "秋冬作事只尋常",
      "春到門庭漸吉昌",
      "千里信音符遠望",
      "萱堂快樂未渠央"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/31"
  },
  {
    "number": 32,
    "title": "第32簽 下下",
    "poem": [
      "勞心汨汨竟何歸",
      "疾病兼多是與非",
      "事到頭來渾似夢",
      "何如休要用心機"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/32"
  },
  {
    "number": 33,
    "title": "第33簽 中平",
    "poem": [
      "不分南北與西東",
      "眼底昏昏耳似聾",
      "熟讀黃庭經一卷",
      "不論貴賤與窮通"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/33"
  },
  {
    "number": 34,
    "title": "第34簽 中平",
    "poem": [
      "春夏纔過秋又冬",
      "紛紛謀慮攪心胸",
      "貴人垂手來相援",
      "休把私心情意濃"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/34"
  },
  {
    "number": 35,
    "title": "第35簽 下下",
    "poem": [
      "一山如畫對清江",
      "門裏團圓事事雙",
      "誰料半途分折去",
      "空幃無語對銀缸"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/35"
  },
  {
    "number": 36,
    "title": "第36簽 上吉",
    "poem": [
      "功名富貴自能為",
      "偶著仙鞭莫問伊",
      "萬里鵬程君有分",
      "吳山頂上好鑽龜"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/36"
  },
  {
    "number": 37,
    "title": "第37簽 中平",
    "poem": [
      "焚香來告復何辭",
      "善惡平分汝自知",
      "屏卻昧公心裏事",
      "出門無礙是通時"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/37"
  },
  {
    "number": 38,
    "title": "第38簽 下下",
    "poem": [
      "蛩吟唧唧守孤幃",
      "千里懸懸望信歸",
      "等得榮華公子到",
      "秋冬括括雨靡靡"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/38"
  },
  {
    "number": 39,
    "title": "第39簽 下下",
    "poem": [
      "北山門下好安居",
      "若問終時慎厥初",
      "堪笑包藏許多事",
      "鱗鴻雖便莫修書"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/39"
  },
  {
    "number": 40,
    "title": "第40簽 上吉",
    "poem": [
      "新來換得好規模",
      "何用隨他步與趨",
      "只聽耳邊消息到",
      "崎嶇歷盡見亨衢"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/40"
  },
  {
    "number": 41,
    "title": "第41簽 中吉",
    "poem": [
      "自南自北自東西",
      "欲到天涯誰作梯",
      "遇鼠逢牛三弄笛",
      "好將名姓榜頭題"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/41"
  },
  {
    "number": 42,
    "title": "第42簽 中吉",
    "poem": [
      "我曾許汝事和諧",
      "誰料修為汝自乖",
      "但改新圖莫依舊",
      "營謀應得稱心懷"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/42"
  },
  {
    "number": 43,
    "title": "第43簽 中吉",
    "poem": [
      "一紙官書火急催",
      "扁舟速下浪如雷",
      "雖然目下多驚險",
      "保汝平安去復回"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/43"
  },
  {
    "number": 44,
    "title": "第44簽 中平",
    "poem": [
      "汝是人中最吉人",
      "誤為誤作損精神",
      "堅牢一念酬香願",
      "富貴榮華萃汝身"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/44"
  },
  {
    "number": 45,
    "title": "第45簽 中平",
    "poem": [
      "好將心地力耕耘",
      "彼此山頭總是墳",
      "陰地不如心地好",
      "修為到底卻輸君"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/45"
  },
  {
    "number": 46,
    "title": "第46簽 中平",
    "poem": [
      "君是山中萬戶侯",
      "信知騎馬勝騎牛",
      "今朝馬上看山色",
      "爭似騎牛得自由"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/46"
  },
  {
    "number": 47,
    "title": "第47簽 下下",
    "poem": [
      "與君萬語復千言",
      "祗欲平和雪爾冤",
      "訟則終凶君記取",
      "試於清夜把心捫"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/47"
  },
  {
    "number": 48,
    "title": "第48簽 中平",
    "poem": [
      "登山涉水正天寒",
      "兄弟姻親那得安",
      "幸遇虎頭人一喚",
      "全家遂保汝重歡"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/48"
  },
  {
    "number": 49,
    "title": "第49簽 下下",
    "poem": [
      "彼此家居只一山",
      "如何似隔鬼門關",
      "日月如梭人易老",
      "許多勞碌不如閒"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/49"
  },
  {
    "number": 50,
    "title": "第50簽 上平",
    "poem": [
      "人說今年勝舊年",
      "也須步多要周旋",
      "一家和氣多生福",
      "萋菲讒言莫聽偏"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/50"
  },
  {
    "number": 51,
    "title": "第51簽 上吉",
    "poem": [
      "君今百事且隨緣",
      "水到渠成聽自然",
      "莫嘆年來不如意",
      "喜逢新運稱心田"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/51"
  },
  {
    "number": 52,
    "title": "第52簽 上吉",
    "poem": [
      "兀坐幽居歎寂寥",
      "孤燈掩映度清宵",
      "萬金忽報秋光好",
      "活計扁舟渡北朝"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/52"
  },
  {
    "number": 53,
    "title": "第53簽 下下",
    "poem": [
      "艱難險阻路蹊蹺",
      "南鳥孤飛依北巢",
      "今日貴人曾識面",
      "相逢卻在夏秋交"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/53"
  },
  {
    "number": 54,
    "title": "第54簽 中平",
    "poem": [
      "萬人叢裏逞英豪",
      "便欲飛騰霄漢高",
      "爭奈承流風未便",
      "青燈黃卷且勤勞"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/54"
  },
  {
    "number": 55,
    "title": "第55簽 中平",
    "poem": [
      "勤耕力作莫蹉跎",
      "衣食隨時安分過",
      "縱使經商收倍利",
      "不如逐歲廩禾多"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/55"
  },
  {
    "number": 56,
    "title": "第56簽 下下",
    "poem": [
      "心頭理曲強詞遮",
      "直欲欺官行路斜",
      "一旦醜形臨月鏡",
      "身投憲網莫咨嗟"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/56"
  },
  {
    "number": 57,
    "title": "第57簽 中平",
    "poem": [
      "事端百出慮雖長",
      "莫聽人言自主張",
      "一著仙機君記取",
      "紛紛鬧裏更思量"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/57"
  },
  {
    "number": 58,
    "title": "第58簽 上吉",
    "poem": [
      "蘇秦三寸足平生",
      "富貴功名在此行",
      "更好修為陰騭事",
      "前程萬里自通亨"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/58"
  },
  {
    "number": 59,
    "title": "第59簽 中平",
    "poem": [
      "門衰戶冷苦伶仃",
      "自嘆祈求不一靈",
      "幸有祖宗陰騭在",
      "香煙未斷續螟蛉"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/59"
  },
  {
    "number": 60,
    "title": "第60簽 上上",
    "poem": [
      "羨君兄弟好名聲",
      "只管謙撝莫自矜",
      "丹詔槐黃相逼近",
      "巍巍科甲兩同登"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/60"
  },
  {
    "number": 61,
    "title": "第61簽 中平",
    "poem": [
      "嘯聚山林兇惡儔",
      "善良無事苦煎憂",
      "主人大笑出門去",
      "不用干戈盜賊休"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/61"
  },
  {
    "number": 62,
    "title": "第62簽 中平",
    "poem": [
      "百千人面虎狼心",
      "賴汝干戈用力深",
      "得勝回時秋漸老",
      "虎頭城裏喜相尋"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/62"
  },
  {
    "number": 63,
    "title": "第63簽 中平",
    "poem": [
      "曩時敗北且圖南",
      "筋力雖衰尚一堪",
      "欲識生前君大數",
      "前三三與後三三"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/63"
  },
  {
    "number": 64,
    "title": "第64簽 上上",
    "poem": [
      "吉人相遇本和同",
      "況有持謀天水翁",
      "人力不勞公論協",
      "事成功倍笑談中"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/64"
  },
  {
    "number": 65,
    "title": "第65簽 上上",
    "poem": [
      "朔風凜凜正窮冬",
      "多羨門庭喜氣濃",
      "更入新春人事後",
      "衷言方得信先容"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/65"
  },
  {
    "number": 66,
    "title": "第66簽 上上",
    "poem": [
      "耕耘只可在鄉邦",
      "何用求謀向外方",
      "見說今年新運好",
      "門闌喜氣事雙雙"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/66"
  },
  {
    "number": 67,
    "title": "第67簽 中平",
    "poem": [
      "纔發君心天已知",
      "何須問我決狐疑",
      "願子改圖從孝悌",
      "不愁家室不相宜"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/67"
  },
  {
    "number": 68,
    "title": "第68簽 中平",
    "poem": [
      "南販珍珠北販鹽",
      "年來幾倍貨財添",
      "勸君止此求田舍",
      "心欲多時何日厭"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/68"
  },
  {
    "number": 69,
    "title": "第69簽 下下",
    "poem": [
      "捨舟遵路總相宜",
      "慎勿嬉遊逐貴兒",
      "一夜樽前兄與弟",
      "明朝仇敵又相隨"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/69"
  },
  {
    "number": 70,
    "title": "第70簽 中平",
    "poem": [
      "雷雨風雲各有司",
      "至誠禱告莫生疑",
      "與君定約為霖日",
      "正是蘊隆中伏時"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/70"
  },
  {
    "number": 71,
    "title": "第71簽 中平",
    "poem": [
      "喜鵲簷前報好音",
      "知君千里欲歸心",
      "繡幃重結鴛鴦帶",
      "葉落霜飛寒色侵"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/71"
  },
  {
    "number": 72,
    "title": "第72簽 下下",
    "poem": [
      "河渠傍路有高低",
      "可歎長途日已西",
      "縱有榮華好時節",
      "直須猴犬換金雞"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/72"
  },
  {
    "number": 73,
    "title": "第73簽 下下",
    "poem": [
      "憶昔蘭房分半釵",
      "而今忽把信音乖",
      "痴心指望成連理",
      "到底誰知事不諧"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/73"
  },
  {
    "number": 74,
    "title": "第74簽 上吉",
    "poem": [
      "崔巍崔魏復崔巍",
      "履險如夷去復來",
      "身似菩提心似鏡",
      "長安一道放春回"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/74"
  },
  {
    "number": 75,
    "title": "第75簽 中吉",
    "poem": [
      "生前結得好緣姻",
      "一笑相逢情自親",
      "相當人物無高下",
      "得意休論富與貧"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/75"
  },
  {
    "number": 76,
    "title": "第76簽 中平",
    "poem": [
      "三千法律八千文",
      "此事何如說與君",
      "善惡兩途君自作",
      "一生禍福此中分"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/76"
  },
  {
    "number": 77,
    "title": "第77簽 下下",
    "poem": [
      "木有根荄水有源",
      "君當自此究其原",
      "莫隨道路人閒話",
      "訟到終凶是至言"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/77"
  },
  {
    "number": 78,
    "title": "第78簽 下下",
    "poem": [
      "家道豊腴自飽溫",
      "也須肚裏立乾坤",
      "財多害己君當省",
      "福有胚胎禍有門"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/78"
  },
  {
    "number": 79,
    "title": "第79簽 中平",
    "poem": [
      "乾亥來龍仔細看",
      "坎居午向自當安",
      "若移丑艮陰陽逆",
      "門戶凋零家道難"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/79"
  },
  {
    "number": 80,
    "title": "第80簽 中平",
    "poem": [
      "一朝無事忽遭官",
      "也是門衰墳未安",
      "改換陰陽移禍福",
      "勸君莫作等閒看"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/80"
  },
  {
    "number": 81,
    "title": "第81簽 中平",
    "poem": [
      "假君財物自當還",
      "謀賴心欺他自奸",
      "幸有高臺明月鏡",
      "請來對照破機關"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/81"
  },
  {
    "number": 82,
    "title": "第82簽 上吉",
    "poem": [
      "彼亦儔中一輩賢",
      "勸君特達與周旋",
      "此時賓主歡相會",
      "他日王侯卻並肩"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/82"
  },
  {
    "number": 83,
    "title": "第83簽 下下",
    "poem": [
      "隨分堂前赴粥饘",
      "何須妄想苦憂煎",
      "主張門戶誠難事",
      "百歲安閒得幾年"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/83"
  },
  {
    "number": 84,
    "title": "第84簽 中平",
    "poem": [
      "箇中事緒更紛然",
      "當局須知一著先",
      "長舌婦人休酷聽",
      "力行禮義要心堅"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/84"
  },
  {
    "number": 85,
    "title": "第85簽 中平",
    "poem": [
      "一春風雨正瀟瀟",
      "千里行人去路遙",
      "移寡就多君得計",
      "如何歸路轉無聊"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/85"
  },
  {
    "number": 86,
    "title": "第86簽 上上",
    "poem": [
      "一舟行貨好招邀",
      "積少成多自富饒",
      "常把他人比自己",
      "管須日後勝今朝"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/86"
  },
  {
    "number": 87,
    "title": "第87簽 下下",
    "poem": [
      "陰裏詳看怪爾曹",
      "舟中敵圖笑中刀",
      "藩籬剖破渾無事",
      "一種天生惜羽毛"
    ],
    "source": "https://zh.wikisource.org/zh-hant/%E9%97%9C%E8%81%96%E5%B8%9D%E5%90%9B%E9%9D%88%E7%B1%A4/87"
  },
  {
    "number": 88,
    "title": "第88簽 上吉",
    "poem": [
      "從前作事總徒勞",
      "纔見新春時漸遭",
      "百計營求都得意",
      "更須守己莫心高"
    ],
