{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.liuyao/schemas/liuyao-follow-up-schema-v0.1.json",
  "title": "Liuyao Follow-up v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "consultationId", "chartId", "scope", "reason", "answer", "citedLines"],
  "properties": {
    "version": { "const": "liuyao-follow-up-v0.1" },
    "consultationId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "chartId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "scope": { "enum": ["same_consultation", "new_consultation", "needs_clarification"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "answer": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "citedLines": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 6,
      "items": { "type": "integer", "minimum": 1, "maximum": 6 }
    }
  }
}
