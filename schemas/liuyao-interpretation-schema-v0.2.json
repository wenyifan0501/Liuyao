{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.liuyao/schemas/liuyao-interpretation-schema-v0.2.json",
  "title": "Liuyao Interpretation v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysisVersion", "chartId", "chartRuleVersion", "question", "anchors", "evidence", "decision", "judgment", "timingCandidates", "actionAdvice", "nextQuestion", "safetyNotes"],
  "properties": {
    "analysisVersion": { "const": "liuyao-interpretation-v0.2" },
    "chartId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "chartRuleVersion": { "const": "liuyao-chart-v0.1" },
    "question": { "$ref": "#/$defs/question" },
    "anchors": { "$ref": "#/$defs/anchors" },
    "evidence": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "$ref": "#/$defs/evidence" } },
    "decision": { "$ref": "#/$defs/decision" },
    "judgment": { "$ref": "#/$defs/judgment" },
    "timingCandidates": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/timingCandidate" } },
    "actionAdvice": { "$ref": "#/$defs/shortTextList" },
    "nextQuestion": { "$ref": "#/$defs/nextQuestion" },
    "safetyNotes": { "$ref": "#/$defs/shortTextList" }
  },
  "$defs": {
    "relative": { "enum": ["siblings", "offspring", "parents", "wealth", "officials"] },
    "lineNumber": { "type": "integer", "minimum": 1, "maximum": 6 },
    "shortTextList": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["topic", "normalizedQuestion", "timeWindow"],
      "properties": {
        "topic": { "enum": ["daily", "career", "exam", "finance", "relationship", "cooperation", "travel", "lost_property", "health_tendency", "market_trend", "other"] },
        "normalizedQuestion": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "timeWindow": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 300 }, { "type": "null" }] }
      }
    },
    "usefulGod": {
      "type": "object", "additionalProperties": false,
      "required": ["relative", "line", "reason"],
      "properties": { "relative": { "$ref": "#/$defs/relative" }, "line": { "$ref": "#/$defs/lineNumber" }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 } }
    },
    "secondaryAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "line", "reason"],
      "properties": { "kind": { "enum": ["self", "response", "counterpart", "document", "income", "other"] }, "line": { "$ref": "#/$defs/lineNumber" }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 } }
    },
    "anchors": {
      "type": "object", "additionalProperties": false,
      "required": ["selfLine", "responseLine", "primaryUsefulGod", "usefulGodCandidates", "secondaryAnchors"],
      "properties": {
        "selfLine": { "$ref": "#/$defs/lineNumber" }, "responseLine": { "$ref": "#/$defs/lineNumber" },
        "primaryUsefulGod": { "anyOf": [{ "$ref": "#/$defs/usefulGod" }, { "type": "null" }] },
        "usefulGodCandidates": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/usefulGod" } },
        "secondaryAnchors": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/secondaryAnchor" } }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "line", "factIds", "effect", "fact", "reason"],
      "properties": {
        "source": { "enum": ["line", "month", "day", "change", "context"] },
        "line": { "anyOf": [{ "$ref": "#/$defs/lineNumber" }, { "type": "null" }] },
        "factIds": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "effect": { "enum": ["supporting", "weakening", "ambiguous"] },
        "fact": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["coreDilemma", "directAnswer", "preferredOption", "alternativeTradeoff", "personalizedSignals", "reversalConditions"],
      "properties": {
        "coreDilemma": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "directAnswer": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "preferredOption": { "type": "string", "minLength": 1, "maxLength": 500 },
        "alternativeTradeoff": { "type": "string", "minLength": 1, "maxLength": 800 },
        "personalizedSignals": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "reversalConditions": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "judgment": {
      "type": "object", "additionalProperties": false,
      "required": ["tendency", "summary", "conditions", "confidence", "uncertainties"],
      "properties": {
        "tendency": { "enum": ["favorable", "mixed_favorable", "neutral_uncertain", "mixed_unfavorable", "unfavorable"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "conditions": { "$ref": "#/$defs/shortTextList" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "uncertainties": { "$ref": "#/$defs/shortTextList" }
      }
    },
    "timingCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["window", "basis", "certainty"],
      "properties": { "window": { "type": "string", "minLength": 1, "maxLength": 300 }, "basis": { "type": "string", "minLength": 1, "maxLength": 1000 }, "certainty": { "enum": ["low", "medium"] } }
    },
    "nextQuestion": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt", "purpose", "choices"],
      "properties": {
        "prompt": { "type": "string", "minLength": 5, "maxLength": 500 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
        "choices": { "type": "array", "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    }
  }
}
