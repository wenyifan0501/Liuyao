DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_STREAM=true
LIUYAO_LOG_MODE=diagnostic

# Web API
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
WEB_AI_ENABLED=true
# Quota switch. Leave false during internal testing (unlimited use); set true
# before a public rollout to re-enable trial counts, follow-up caps and budgets.
WEB_QUOTA_ENFORCED=false
# Conservative daily token reservations, including failures; resets at UTC midnight.
# Only applied when WEB_QUOTA_ENFORCED=true.
WEB_AI_DAILY_TOKEN_BUDGET=2400000
WEB_AI_USER_DAILY_CALLS=12
